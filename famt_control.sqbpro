-- SQUAD FAMT - CONTROLE DE PRIMEIRO ACESSO VIA SQL
-- Engenheira de Banco de Dados: Thamirys Matos da Silva
-- =============================================================================

-- 1. LIMPEZA DO AMBIENTE (Para rodar o teste do zero)
DROP TABLE IF EXISTS Transacoes;
DROP TABLE IF EXISTS Usuarios;

-- 2. CRIAÇÃO DA TABELA DE USUÁRIOS ATUALIZADA
-- Adicionamos 'primeiro_acesso'. Por padrão, todo usuário novo começa com 1 (Sim).
CREATE TABLE Usuarios (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    email TEXT UNIQUE NOT NULL,
    senha_hash TEXT NOT NULL,
    primeiro_acesso INTEGER DEFAULT 1 -- 1 = Precisa trocar | 0 = Senha definitiva
);

-- 3. CADASTRANDO UM USUÁRIO COM SENHA PROVISÓRIA
-- Ao cadastrar, não informamos o 'primeiro_acesso' para ele assumir o valor 1 automaticamente.
INSERT INTO Usuarios (email, senha_hash) 
VALUES ('thamirys@famt.com', 'famt123');


-- =============================================================================
-- SIMULAÇÃO DE COMO O SISTEMA CONSULTA E REDEFINE A SENHA
-- =============================================================================

-- PASSO A: O sistema verifica se o usuário precisa redefinir a senha no login
-- Se o resultado da coluna 'primeiro_acesso' for 1, o sistema bloqueia e exige a troca.
SELECT email, primeiro_acesso FROM Usuarios WHERE email = 'thamirys@famt.com';


-- PASSO B: Comando executado quando o usuário digita a nova senha definitiva
-- Aqui atualizamos a senha e mudamos o 'primeiro_acesso' para 0.
UPDATE Usuarios 
SET senha_hash = 'MinhaSenhaSegura999', 
    primeiro_acesso = 0 
WHERE email = 'thamirys@famt.com';


-- PASSO C: Verificação final
-- Rode este SELECT final para ver que a senha mudou e o status agora é 0 (Acesso Liberado!)
SELECT * FROM Usuarios;</sql><current_tab id="0"/></tab_sql></sqlb_project>
